# Local development only. Generate a private key for production deployment.
DJANGO_SECRET_KEY=replace-this-for-local-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL connection. Set POSTGRES_PASSWORD to the password configured
# for this role on your machine.
POSTGRES_DB=codeyoung
POSTGRES_USER=codeyoung
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRIAL_CLASS_DURATION_MINUTES=30
TRIAL_CLASS_SLOT_STEP_MINUTES=30
FRONTEND_BASE_URL=http://localhost:5173

# SMTP sender configuration. Use credentials from an authorized email provider.
# Keep real credentials only in backend/.env, which is ignored by Git.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10

# Optional: route one seeded mentor to a deliverable test inbox.
DEMO_MENTOR_NAME=Aarav Nair
DEMO_MENTOR_EMAIL=
